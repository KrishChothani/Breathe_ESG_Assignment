# ── Django ────────────────────────────────────────────────────────────────────
# Generate a fresh secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-this

# Set to 'config.settings.production' in prod, 'config.settings.development' locally
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True

# ── Supabase PostgreSQL connection ────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection String → URI
# For local dev (avoids IPv6 issues) use the pooler URL:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# For production use the direct URL:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase project details ──────────────────────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Navan Trips API ───────────────────────────────────────────────────────────
NAVAN_CLIENT_ID=your-navan-client-id
NAVAN_CLIENT_SECRET=your-navan-client-secret
NAVAN_AUTH_URL=https://api.navan.com/auth/v1/token
NAVAN_BASE_URL=https://app.navan.com/open-api/trips/v1

# ── Concur API ────────────────────────────────────────────────────────────────
CONCUR_CLIENT_ID=your-concur-client-id
CONCUR_CLIENT_SECRET=your-concur-client-secret
CONCUR_BASE_URL=https://us.api.concursolutions.com

# ── Gemini Vision API (Bill OCR) ────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
